# Environment variables for SehatPlate
# Secrets (DATABASE_URL, SESSION_SECRET) are provided via the platform Secrets panel.
# Add other values in the Secrets panel; never commit them.

# Database (auto-provided by platform)
DATABASE_URL=        # PostgreSQL connection string (auto-provided in Secrets)

# JWT & Auth (auto-provided by platform)
SESSION_SECRET=      # JWT signing secret (auto-provided in Secrets; app exits if missing)
JWT_EXPIRE_MINUTES=  # e.g. 60 (default)
API_PORT=            # e.g. 3001 (default)

# Frontend (CORS)
FRONTEND_ORIGIN=     # e.g. https://your-preview-url (CORS allowlist; empty allows all)

# AI (Groq; used by POST /dish/identify for photos only)
GROQ_API_KEY=        # Groq API key; read by server/ai.js only (the only file that calls Groq)
GROQ_VISION_MODEL=   # Groq vision-capable model id; used by server/ai.js for uploaded photos
GROQ_TEXT_MODEL=     # Groq text model id; used by server/ai.js for text prompts (typed names on /dish/identify are matched locally, no Groq call)

# Frontend (ignore; Vite proxy handles this)
VITE_API_URL=        # Leave unset; client uses relative URLs and Vite forwards /health, /auth, /me, /dish, /api to port 3001
