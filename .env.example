# Environment variables for SehatPlate
# DATABASE_URL and SESSION_SECRET are provided automatically via the Secrets panel

SESSION_SECRET=      # JWT signing secret (provided automatically)
JWT_EXPIRE_MINUTES=  # e.g. 60 (default)
GROQ_API_KEY=        # Groq API key (required for AI features)
GROQ_VISION_MODEL=   # e.g. llava-v1.5-7b-4096-preview
GROQ_TEXT_MODEL=     # e.g. llama3-8b-8192
FRONTEND_ORIGIN=     # e.g. https://your-preview-url (CORS allowlist)
VITE_API_URL=        # e.g. (leave empty; Vite proxy forwards /health, /api, /auth, /me)
